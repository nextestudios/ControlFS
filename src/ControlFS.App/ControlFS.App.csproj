<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Aplicação WinUI 3 (Windows App SDK). A interface é construída em C# (sem marcação XAML compilada)
    para que todo o código de UI seja verificado pelo compilador também fora do Windows.
    Ver docs/decisions/0003-ui-em-csharp-sem-xaml-compilado.md.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ControlFS.App</RootNamespace>
    <AssemblyName>ControlFS</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Necessário mesmo sem MSIX: gera o PRI do app que aponta para os recursos do WinUI
         (sem ele: "Cannot locate resource from ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml"). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- "resources.pri" é encontrado qualquer que seja o nome do .exe; com o nome padrão (ControlFS.pri) o portátil
         renomeado para ControlFS-Portable-x64.exe procurava ControlFS-Portable-x64.pri e fechava ao abrir. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ícone oficial (logos/controlfs-icon.png → assets/controlfs.ico, gerado por build/make-icons.py com fundo transparente): executável, atalhos, Alt+Tab. -->
    <ApplicationIcon>..\..\assets\controlfs.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Portátil: um único .exe que se extrai sozinho na primeira execução. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <!-- Pacote portátil: Windows App SDK incluído (validar em máquina limpa antes de anunciar). -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <!-- makepri.exe e mt.exe só existem no Windows; fora dele compilamos apenas para verificação de tipos. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <!-- Sem o pacote Microsoft.WindowsAppSDK.Runtime (#85) o SDK assume self-contained, que chama mt.exe. Fora do Windows
         compilamos como dependente de framework, só para verificação: o diretório falso cala a checagem do Runtime e os
         inicializadores (que precisam dele) ficam desligados. Nada disso vale para os pacotes, sempre feitos no Windows. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <MicrosoftWindowsAppSDKPackageDir>$(MSBuildProjectDirectory)</MicrosoftWindowsAppSDKPackageDir>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ícone da janela/barra de tarefas (AppWindow.SetIcon). -->
    <Content Include="..\..\assets\controlfs.ico" Link="controlfs.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Logo com texto (cabeçalho da tela inicial e "Sobre"). -->
    <Content Include="..\..\assets\controlfs-logo-text-900.png" Link="controlfs-logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Componentes, não o metapacote Microsoft.WindowsAppSDK (#85): sem IA/ML, Widgets, Search e DWriteCore. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ControlFS.Core\ControlFS.Core.csproj" />
    <ProjectReference Include="..\ControlFS.Application\ControlFS.Application.csproj" />
    <ProjectReference Include="..\ControlFS.Infrastructure.Windows\ControlFS.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\ControlFS.Infrastructure.Input.Sdl3\ControlFS.Infrastructure.Input.Sdl3.csproj" />
    <ProjectReference Include="..\ControlFS.Infrastructure.Media\ControlFS.Infrastructure.Media.csproj" />
    <ProjectReference Include="..\ControlFS.Infrastructure.Archives\ControlFS.Infrastructure.Archives.csproj" />
    <ProjectReference Include="..\ControlFS.Infrastructure.Updates\ControlFS.Infrastructure.Updates.csproj" />
  </ItemGroup>
</Project>
