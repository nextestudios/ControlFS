<Project Sdk="Microsoft.NET.Sdk">
  <!-- Núcleo do produto: sem dependência de WinUI, SDL3 ou SharpCompress. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ControlFS.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ControlFS.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sons do controle (#287): quatro WAV curtos (Kenney, CC0), embutidos para tocar da memória. -->
    <EmbeddedResource Include="..\..\assets\sounds\*.wav" LogicalName="sounds/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
